{
    "listeners": {
        "*:80": {
            "pass": "routes"
        }
    },
    "routes": [
        {
            "match": {
                "uri": [
                    "/adminer.css*",
                    "/adminer/adminer.css*"
                ]
            },
            "action": {
                "share": "/var/www/html/admin/tools/adminer.css"
            }
        },
        {
            "match": {
                "uri": [
                    "*.css", "*.js", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.mp4",
                    "*.svg", "*.ico", "*.woff", "*.woff2", "*.ttf", "*.eot", "*.webm"
                ]
            },
            "action": {
                "share": "/var/www/html$uri",
                "fallback": {
                    "pass": "applications/php_client"
                }
            }
        },
        {
            "match": {
                "uri": "/adminer*"
            },
            "action": {
                "pass": "applications/php_adminer"
            }
        },
        {
            "match": {
                "uri": "/api/*"
            },
            "action": {
                "pass": "applications/php_api"
            }
        },
        {
            "match": {
                "uri": "/admin/*"
            },
            "action": {
                "pass": "applications/php_admin"
            }
        },
        {
            "action": {
                "pass": "applications/php_client"
            }
        }
    ],
    "applications": {
        "php_client": {
            "type": "php",
            "root": "/var/www/html",
            "script": "client/index.php"
        },
        "php_admin": {
            "type": "php",
            "root": "/var/www/html",
            "script": "admin/index.php"
        },
        "php_adminer": {
            "type": "php",
            "root": "/var/www/html/admin/tools",
            "script": "adminer.php"
        },
        "php_api": {
            "type": "php",
            "root": "/var/www/html"
        }
    }
}
